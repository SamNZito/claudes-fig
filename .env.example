# ---- Required ------------------------------------------------------------
# Discord bot token (discord.com/developers/applications -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=
# xAI API key (console.x.ai)
XAI_API_KEY=

# ---- Grok ----------------------------------------------------------------
GROK_MODEL=grok-4.7
# Empty = same as GROK_MODEL
GROK_VISION_MODEL=
# low keeps voice replies snappy. Options: low | medium | high | xhigh | none (don't send it)
GROK_REASONING_EFFORT=low
STT_MODEL=grok-voice-transcribe-2.0
STT_LANGUAGE=en
TTS_VOICE=eve
TTS_LANGUAGE=en

# ---- Fig -----------------------------------------------------------------
WAKE_NAME=Fig
# normal = Fig only responds when you say its name. conversation = no name needed.
# Every new call starts in normal (RESET_MODE_ON_JOIN=true).
DEFAULT_MODE=normal
RESET_MODE_ON_JOIN=true
# fig | intense | groupchat | helpdesk | tryhard | zombie | villager | brit | egirl | pregnant
DEFAULT_PERSONALITY=fig

# ---- Sound ---------------------------------------------------------------
# Music volume 0-100. Starts quiet enough for a call.
DEFAULT_VOLUME=20
# How far music dips while Fig talks (0-1). DUCK_MODE=wait pauses the music under speech instead.
DUCK_LEVEL=0.25
DUCK_MODE=duck
VOICE_VOLUME=1.0
# Even out loudness between songs
NORMALIZE_AUDIO=true
MAX_TRACK_MINUTES=20
TRACK_START_TIMEOUT_SEC=30
STALL_TIMEOUT_SEC=20

# ---- Tools (leave empty if they are on PATH) -----------------------------
YTDLP_PATH=
FFMPEG_PATH=
# Optional SoundCloud login cookies (cookies.txt) if you have SoundCloud Go+ for full tracks
YTDLP_COOKIES=
YTDLP_EXTRA_ARGS=
# Only needed if SoundCloud blocks this machine's region: http://user:pass@host:port
YTDLP_PROXY=

# ---- Music ----------------------------------------------------------------
# Audio comes from SoundCloud. YouTube is not used.
# Spotify is used to look songs up (exact artist / title / length, and Spotify links). Optional but recommended:
# developer.spotify.com -> Create app -> copy Client ID and Client Secret. (Since Feb 2026 the app owner needs Premium.)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MUSIC_SOURCES=soundcloud
SOURCE_COOLDOWN_MIN=10
# Every copy is probed before it plays: previews, DRM and refused downloads are rejected up front.
PROBE_TIMEOUT_SEC=30
# Give up on a request (and say why) after this long finding a copy that plays.
RESOLVE_BUDGET_SEC=60
# A copy that stops before this many seconds (and well short of its length) is a bad file, not the end of the song.
MIN_SONG_SEC=45
# A skipped song can't come back (DJ, another upload, a queued duplicate) for this long. Asking for it again lifts it.
SKIP_BLOCK_HOURS=6

# ---- Voice channel behaviour ---------------------------------------------
# Join the channel people are in automatically
AUTO_JOIN=true
# Fig's home voice channel (name or id). It goes here on startup and after any restart.
HOME_VOICE_CHANNEL=zzzz
# Stay in the home channel even when it is empty (music stops, Fig stays so it's there when you arrive)
STAY_IN_HOME=true
# Leave after the channel has been empty this long
EMPTY_LEAVE_SECONDS=60
# Post "now playing" etc. here instead of the voice channel's chat (optional channel id)
ANNOUNCE_CHANNEL_ID=
# Limit Fig to these servers (comma separated ids). Empty = every server it is in.
GUILD_IDS=

# ---- Listening -----------------------------------------------------------
LISTEN=true
VAD_SILENCE_MS=800
MIN_UTTERANCE_MS=400
MAX_UTTERANCE_SEC=20

# ---- DJ ------------------------------------------------------------------
DJ_BATCH=8
DJ_MEMORY_SIZE=400
# Fig says a short line when a DJ song starts
DJ_TALK=false

LOG_LEVEL=info
